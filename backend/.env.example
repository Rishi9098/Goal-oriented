# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=Northstar API
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://northstar:northstar@localhost:5432/northstar
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_64_byte_hex_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── AI / Copilot ─────────────────────────────────────────────────────────────
# Leave blank to use rule-based fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── Monte Carlo ───────────────────────────────────────────────────────────────
MONTE_CARLO_SIMULATIONS=10000
# Optional fixed seed for reproducibility (leave blank for random)
MONTE_CARLO_SEED=

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
