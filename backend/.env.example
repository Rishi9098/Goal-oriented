# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=Northstar API
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://northstar:northstar@localhost:5432/northstar
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_64_byte_hex_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Refresh token cookie names (rarely need to change these) and an optional
# explicit cookie Domain (leave blank for host-only, the common case).
REFRESH_COOKIE_NAME=ns_refresh_token
CSRF_COOKIE_NAME=ns_csrf_token
COOKIE_DOMAIN=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Must be explicit (no "*") since
# the refresh-token cookie flow requires allow_credentials=True.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── AI / Copilot ─────────────────────────────────────────────────────────────
# Leave blank to use rule-based fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── Monte Carlo ───────────────────────────────────────────────────────────────
MONTE_CARLO_SIMULATIONS=10000
# Optional fixed seed for reproducibility (leave blank for random)
MONTE_CARLO_SEED=

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BUCKET_TTL_SECONDS=600
RATE_LIMIT_MAX_BUCKETS=50000
# IPs of reverse proxies/load balancers allowed to set X-Forwarded-For.
# Leave blank in single-instance/no-proxy deployments. If this app runs
# behind a load balancer, set this to the LB's IP(s) or its traffic will
# all be rate-limited as a single client.
TRUSTED_PROXY_IPS=[]
